+		if ((buf[15] == 0x77 && buf[14] == 0x88)) {
+			D("%s: catch overlay section in index %d\n",
+				__func__, i);
+
+			/* record index of overlay section */
+			allovlidx |= 1<<i;
+
+			ovl_idx_t = i;
+		//	if (buf[15] == 0x55 && buf[14] == 0x66) {
