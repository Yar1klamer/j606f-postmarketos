# Kernel config based on: sm6125_defconfig
maintainer="Barnabas Czeman <barnabas.czeman@postmarketos.org>"
_flavor="nura-qcom-sm61x5"
pkgname=linux-$_flavor
pkgver=7.2.3
pkgrel=117
pkgdesc="Close to mainline linux kernel for Qualcomm Snapdragon SM61x5"
arch="aarch64"
_carch="arm64"
url="https://codeberg.org/sm61x5-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

_tag="$pkgver-r0"

source="
	$pkgname-v$_tag.tar.gz::https://codeberg.org/sm61x5-mainline/linux/archive/v$_tag.tar.gz
	config-$_flavor.aarch64
	0001-drm-panel-himax-hx83102-add-Lenovo-J606F-BOE-HX83102P.patch
	0003-arm64-dts-qcom-sm6115p-lenovo-j606f-add-HX83102P-SKU.patch
	0004-power-supply-add-read-only-Qualcomm-PMI632-charger-driver.patch
	0005-power-supply-mm8013-fix-current-sign-notify-report-Li-ion.patch
	0006-Input-add-Himax-HX83102E-touchscreen-for-Lenovo-J606F.patch
	0007-arm64-dts-qcom-sm6115p-lenovo-j606f-split-common-add-NT36523W-SKU.patch
	0008-arm64-dts-qcom-sm6115p-lenovo-j606f-USB-C-OTG-via-FUSB302.patch
	0009-arm64-dts-qcom-sm6115p-lenovo-j606f-GPU-DDR-bandwidth-votes.patch
	0010-usb-dwc3-qcom-re-select-UTMI-as-PIPE-clock-on-resume.patch
	0011-arm64-dts-qcom-sm6115-add-Venus-video-codec.patch
	0012-arm64-dts-qcom-sm6115-add-LPASS-devices.patch
	0013-ASoC-codecs-add-Awinic-AW88258-amplifier-driver.patch
	0014-ASoC-qcom-sm8250-add-primary-TDM-speaker-playback.patch
	0015-soundwire-qcom-recover-from-clock-stop-without-devices.patch
	0016-arm64-dts-qcom-sm6115p-lenovo-j606f-add-audio.patch
"
builddir="$srcdir/linux"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot

	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	# Install vmlinuz for boot.img for avoid EFI image packed installed by zinstall
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
		"$pkgdir/boot/vmlinuz"

	install -Dm644 "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}
