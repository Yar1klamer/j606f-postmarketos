From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yar1klamer
Subject: [PATCH] libcamera: Add S5K4H7 sensor helper and properties

Linear analogue gain (0x20 = 1x, register 0x0204), black level 64 at
10 bits, 1.12 um pixels and the sensor test patterns, as found in the
stock CamX module of the Lenovo Tab P11 front camera.
---
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -852,6 +852,19 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13b10", CameraSensorHelperOv13b10)
 
+class CameraSensorHelperS5k4h7 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k4h7()
+	{
+		/* Black level 64 (10-bit), from the CamX sensor module */
+		blackLevel_ = 4096;
+		/* Analogue gain register 0x0204: 0x20 = 1x, linear */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k4h7", CameraSensorHelperS5k4h7)
+
 class CameraSensorHelperVd55g1 : public CameraSensorHelper
 {
 public:
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -527,6 +527,17 @@
 			},
 			.sensorDelays = { },
 		} },
+		{ "s5k4h7", {
+			.unitCellSize = { 1120, 1120 },
+			.testPatternModes = {
+				{ controls::draft::TestPatternModeOff, 0 },
+				{ controls::draft::TestPatternModeSolidColor, 1 },
+				{ controls::draft::TestPatternModeColorBars, 2 },
+				{ controls::draft::TestPatternModeColorBarsFadeToGray, 3 },
+				{ controls::draft::TestPatternModePn9, 4 },
+			},
+			.sensorDelays = { },
+		} },
 		{ "vd55g1", {
 			.unitCellSize = { 2160, 2160 },
 			.testPatternModes = {
