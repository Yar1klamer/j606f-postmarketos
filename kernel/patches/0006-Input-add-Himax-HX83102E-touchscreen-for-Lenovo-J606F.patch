+	}
+	else
+	{
+		power_supply_set_property(psy,POWER_SUPPLY_PROP_screen_status,&reta);
+	}
+
+	psy = power_supply_get_by_name("mcu_kbd");
+	if(!psy)
+	{
+		pr_err("======================mcu_kbd psy=======null======\n", __func__);
+	}
+	else
+	{
+		power_supply_set_property(psy,POWER_SUPPLY_PROP_screen_status,&reta);
+	}
+}*/
+struct himax_ts_data *ts_drm_data;
+void himax_drm_notify_work(struct work_struct *work)
+{
+	struct himax_ts_data *ts = ts_drm_data;
+
+	if (NULL == work) {
+		E("%s:  parameter work are null!\n", __func__);
+		return;
+	}
+
+	if (ts->ts_suspend) {
+		himax_common_suspend(ts->dev);
+	} else  {
+		himax_common_resume(ts->dev);
+	}
+}
+
+static int himax_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct himax_ts_data *ts = container_of(follower, struct himax_ts_data, panel_follower);
+
+	ts_drm_data = ts;
+	if (!ts->follower_ready)
+		return 0;
+	ts->ts_suspend = false;
+	queue_work(ts->himax_drm_notify_wq, &ts->himax_drm_notify);
+	himax_screen_off = false;
+	return 0;
+}
+
+static int himax_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct himax_ts_data *ts = container_of(follower, struct himax_ts_data, panel_follower);
+
+	ts_drm_data = ts;
+	if (!ts->follower_ready || !ts->initialized)
+		return 0;
+	ts->ts_suspend = true;
+	/* синхронно: команды тачу нужно отправить, пока панель ещё питается */
+	flush_work(&ts->himax_drm_notify);
+	himax_common_suspend(ts->dev);
+	himax_screen_off = true;
+	return 0;
+}
+
+const struct drm_panel_follower_funcs himax_panel_follower_funcs = {
+	.panel_prepared = himax_panel_prepared,
+	.panel_unpreparing = himax_panel_unpreparing,
+};
+#endif
+
+int himax_chip_common_probe(struct spi_device *spi)
+{
+	struct himax_ts_data *ts;
+	int ret = 0;
+
+	I("Enter %s\n", __func__);
+	if (spi->controller->flags & SPI_CONTROLLER_HALF_DUPLEX) {
+		dev_err(&spi->dev,
+			"%s: Full duplex not supported by host\n",
+			__func__);
+		return -EIO;
+	}
+
+	gBuffer = kzalloc(sizeof(uint8_t) * HX_MAX_WRITE_SZ, GFP_KERNEL);
+	if (gBuffer == NULL) {
+		E("%s: allocate gBuffer failed\n", __func__);
+		ret = -ENOMEM;
+		goto err_alloc_gbuffer_failed;
+	}
+
+	ts = kzalloc(sizeof(struct himax_ts_data), GFP_KERNEL);
+	if (ts == NULL) {
+		E("%s: allocate himax_ts_data failed\n", __func__);
+		ret = -ENOMEM;
+		goto err_alloc_data_failed;
+	}
+
+	private_ts = ts;
+	spi->bits_per_word = 8;
+	spi->mode = SPI_MODE_3;
+
+	ts->spi = spi;
+	mutex_init(&ts->rw_lock);
+	ts->dev = &spi->dev;
+	dev_set_drvdata(&spi->dev, ts);
+	spi_set_drvdata(spi, ts);
+
+	ts->initialized = false;
+	ret = himax_chip_common_init();
+	if (ret < 0)
+		goto err_common_init_failed;
+
+	return ret;
+
+err_common_init_failed:
+	kfree(ts);
+err_alloc_data_failed:
+	kfree(gBuffer);
+	gBuffer = NULL;
+err_alloc_gbuffer_failed:
+
+	return ret;
+}
+
+void himax_chip_common_remove(struct spi_device *spi)
+{
+	struct himax_ts_data *ts = spi_get_drvdata(spi);
+
+	if (g_hx_chip_inited)
+		himax_chip_common_deinit();
+
+	ts->spi = NULL;
+	/* spin_unlock_irq(&ts->spi_lock); */
+	spi_set_drvdata(spi, NULL);
+	kfree(gBuffer);
+
+	I("%s: completed.\n", __func__);
+}
+
+static const struct dev_pm_ops himax_common_pm_ops = {
+#if (!defined(HX_CONFIG_FB)) && (!defined(HX_CONFIG_DRM))
+	.suspend = himax_common_suspend,
+	.resume  = himax_common_resume,
+#endif
+};
+
+#if defined(CONFIG_OF)
+static const struct of_device_id himax_match_table[] = {
+	{.compatible = "himax,hxcommon" },
+	{},
+};
+#else
+#define himax_match_table NULL
+#endif
+
+static const struct spi_device_id himax_spi_ids[] = {
+	{ "hxcommon" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, himax_spi_ids);
+
+static struct spi_driver himax_common_driver = {
+	.driver = {
+		.name =		HIMAX_common_NAME,
+		.of_match_table = himax_match_table,
+	},
+	.id_table =	himax_spi_ids,
+	.probe =	himax_chip_common_probe,
+	.remove =	himax_chip_common_remove,
+};
+
+int himax_hx83102_register(void);
+void himax_hx83102_unregister(void);
+
+static int __init himax_common_init(void)
+{
+	I("Himax common touch panel driver init\n");
+	D("Himax check double loading\n");
+	if (g_mmi_refcnt++ > 0) {
+		I("Himax driver has been loaded! ignoring....\n");
+		return 0;
+	}
+	himax_hx83102_register();
+	return spi_register_driver(&himax_common_driver);
+}
+
+static void __exit himax_common_exit(void)
+{
+	spi_unregister_driver(&himax_common_driver);
+	himax_hx83102_unregister();
+}
+
+module_init(himax_common_init);
+module_exit(himax_common_exit);
+
+MODULE_DESCRIPTION("Himax HX83102E touchscreen (zero-flash, SPI), port of the Lenovo TB-J606F stock driver");
+MODULE_FIRMWARE("Himax_firmware.bin");
+MODULE_DEVICE_TABLE(of, himax_match_table);
+MODULE_LICENSE("GPL");
