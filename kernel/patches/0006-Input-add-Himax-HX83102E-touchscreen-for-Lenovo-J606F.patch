+#ifdef HX_USB_DETECT_GLOBAL
+static void himax_charger_notify_work(struct work_struct *work)
+{
+	struct input_dev *input_dev = private_ts->input_dev;
+	if (NULL == work) {
+		E("%s:  parameter work are null!\n", __func__);
+		return;
+	}
+
+	if (USB_DETECT_IN == USB_detect_flag) {
+		if (mutex_lock_interruptible(&input_dev->mutex)) {
+			E("Failed to lock in mutex_lock_interruptible(&input_dev->lock).\n");
+			return;
+		}
+		himax_cable_detect_func(true);
+		mutex_unlock(&input_dev->mutex);
+	} else  {
+		if (mutex_lock_interruptible(&input_dev->mutex)) {
+			E("Failed to lock in mutex_lock_interruptible(&ts->lock).\n");
+			return;
+		}
+		himax_cable_detect_func(false);
+		mutex_unlock(&input_dev->mutex);
+	}
+}
+
+static int charger_notifier_callback(struct notifier_block *nb,unsigned long val, void *v)
+{
+	int ret = 0;
+	struct himax_ts_data *ts_data = private_ts;
+	struct power_supply *psy = NULL;
+	struct himax_usb_charger_detection *charger_detection =
+		container_of(nb, struct himax_usb_charger_detection, charger_notif);
+	union power_supply_propval prop;
+
+	psy= power_supply_get_by_name("usb");
+	if (!psy){
+		return -EINVAL;
+		E("Couldn't get usbpsy\n");
+	}
+
+	if (!strcmp(psy->desc->name, "usb")){
+		if (psy && charger_detection && val == POWER_SUPPLY_PROP_STATUS) {
+			ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_PRESENT,&prop);
+			if (ret < 0) {
+				E("Couldn't get POWER_SUPPLY_PROP_ONLINE rc=%d\n", ret);
+				return ret;
+			}
+			else{
+				USB_detect_flag = prop.intval;
+				if(USB_detect_flag != charger_detection->usb_connected) {
+					if (USB_DETECT_IN == USB_detect_flag) {
+						charger_detection->usb_connected = USB_DETECT_IN;
+					}else{
+						charger_detection->usb_connected = USB_DETECT_OUT;
+					}
+					if (!ts_data->suspended){
+						queue_work(charger_detection->himax_charger_notify_wq,&charger_detection->charger_notify_work);
+					}
+				}
+			}
+		}
+	}
+    return 0;
+}
+#endif
