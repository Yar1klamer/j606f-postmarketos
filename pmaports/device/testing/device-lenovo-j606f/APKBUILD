# Reference: <https://nura.eco/devicepkg>
# LOCAL package for Lenovo Tab P11 TB-J606F (HX83102P panel SKU).
pkgname=device-lenovo-j606f
pkgdesc="Lenovo Tab P11 (TB-J606F, HX83102P panel SKU)"
pkgver=1
pkgrel=24
url="https://nura.eco"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools-mkbootimg
	bootmac
	device-mapper
	hexagonrpcd
	hexagonrpcd-systemd
	hexagonrpcd-udev
	kmod
	libssc
	linux-lenovo-j606f
	make-dynpart-mappings
	pil-squasher
	postmarketos-base
	util-linux-misc
"
makedepends="devicepkg-dev"
install="$pkgname.post-install $pkgname.post-upgrade"
triggers="$pkgname.trigger=/lib/firmware/qcom/sm6115/LENOVO/J606F:/usr/lib/firmware/qcom/sm6115/LENOVO/J606F"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	modules-initfs
	j606f-modules-load.conf
	30-gpu-firmware.files
	j606f-charger.sh
	j606f-reboot-flag.sh
	j606f-reboot-mark.service
	j606f-poweroff-unmark.service
	j606f-firmware-extract.sh
	j606f-firmware-extract.service
	Lenovo-TB-J606F.conf
	HiFi.conf
	j606f-audio-modprobe.conf
	j606f-repo.list
	pmos@local-6ae27901.rsa.pub
	j606f-repo-migrate.sh
	j606f-mpv.conf
	j606f-sleep.sh
	j606f-sleep.service
	j606f-resume.service
	j606f-hexagonrpcd-rootpd.conf
	j606f-hexagonrpcd-sensorspd.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/j606f-modules-load.conf "$pkgdir"/usr/lib/modules-load.d/j606f.conf
	# offline charging: initramfs hook for androidboot.mode=charger
	install -Dm755 "$srcdir"/j606f-charger.sh "$pkgdir"/usr/share/mkinitfs/hooks/20-j606f-charger.sh
	# marks reboots in the misc partition so the charger hook can tell them from a cold boot by the charger
	install -Dm755 "$srcdir"/j606f-reboot-flag.sh "$pkgdir"/usr/lib/j606f/reboot-flag
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system "$srcdir"/j606f-reboot-mark.service "$srcdir"/j606f-poweroff-unmark.service
	for t in reboot kexec; do
		mkdir -p "$pkgdir"/usr/lib/systemd/system/$t.target.wants
		ln -s ../j606f-reboot-mark.service "$pkgdir"/usr/lib/systemd/system/$t.target.wants/
	done
	for t in poweroff halt; do
		mkdir -p "$pkgdir"/usr/lib/systemd/system/$t.target.wants
		ln -s ../j606f-poweroff-unmark.service "$pkgdir"/usr/lib/systemd/system/$t.target.wants/
	done
	# Lenovo firmware that no package provides is taken from the tablet's own modem/bluetooth/super partitions
	install -Dm755 "$srcdir"/j606f-firmware-extract.sh "$pkgdir"/usr/lib/j606f/firmware-extract
	install -Dm644 "$srcdir"/j606f-firmware-extract.service "$pkgdir"/usr/lib/systemd/system/j606f-firmware-extract.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../j606f-firmware-extract.service "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/
	# ALSA UCM: speakers (card "Lenovo-TB-J606F" of the sm4250 machine driver)
	install -Dm644 "$srcdir"/Lenovo-TB-J606F.conf "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm4250/Lenovo-TB-J606F.conf
	install -Dm644 "$srcdir"/HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/Lenovo/TB-J606F/HiFi.conf
	install -Dm644 "$srcdir"/j606f-audio-modprobe.conf "$pkgdir"/usr/lib/modprobe.d/j606f-audio.conf
	# port repository without a tag, so plain `apk upgrade` updates it (apk 3 reads /usr/lib/apk/{repositories.d,keys})
	install -Dm644 "$srcdir"/j606f-repo.list "$pkgdir"/usr/lib/apk/repositories.d/j606f.list
	install -Dm644 "$srcdir"/pmos@local-6ae27901.rsa.pub "$pkgdir"/usr/lib/apk/keys/pmos@local-6ae27901.rsa.pub
	# one-time switch of installs that used the "@j606f" repository line
	install -Dm755 "$srcdir"/j606f-repo-migrate.sh "$pkgdir"/usr/lib/j606f/repo-migrate
	# mpv: fast scaling profile and software decoding (measured on the 2000x1200 panel)
	install -Dm644 "$srcdir"/j606f-mpv.conf "$pkgdir"/etc/mpv/mpv.conf
	# suspend: sensors and Bluetooth are stopped for the time of a suspend and restored after it
	install -Dm755 "$srcdir"/j606f-sleep.sh "$pkgdir"/usr/lib/j606f/sleep
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system "$srcdir"/j606f-sleep.service "$srcdir"/j606f-resume.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/sleep.target.wants "$pkgdir"/usr/lib/systemd/system/suspend.target.wants
	ln -s ../j606f-sleep.service "$pkgdir"/usr/lib/systemd/system/sleep.target.wants/
	ln -s ../j606f-resume.service "$pkgdir"/usr/lib/systemd/system/suspend.target.wants/
	# sensors: hexagonrpcd serves the ADSP the files firmware-extract takes from this tablet's partitions
	install -Dm644 "$srcdir"/j606f-hexagonrpcd-rootpd.conf "$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-rootpd.service.d/j606f.conf
	install -Dm644 "$srcdir"/j606f-hexagonrpcd-sensorspd.conf "$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/j606f.conf
}

nonfree_firmware() {
	pkgdesc="GPU/WiFi/BT/DSP firmware"
	# no firmware-lenovo-j606f: firmware-extract takes the Lenovo firmware from the tablet's own
	# partitions (an image without Lenovo blobs); the shared set stays in the repository for a wiped vendor
	depends="linux-firmware-ath10k linux-firmware-qcom
		rmtfs tqftpserv qbootctl"

	# msm is in modules-initfs: the GPU needs its firmware already in the initramfs
	install -Dm644 "$srcdir"/30-gpu-firmware.files \
		"$subpkgdir"/usr/share/mkinitfs/files/30-gpu-firmware.files
}

