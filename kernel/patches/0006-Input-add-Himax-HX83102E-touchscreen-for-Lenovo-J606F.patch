+	int i_max = 0;
+	int i_min = 0;
+	uint32_t dsram_base = 0xFFFFFFFF;
+	uint32_t dsram_max = 0;
+#endif
+#if defined(HX_CODE_OVERLAY)
+	uint8_t tmp_addr[4] = {0xFC, 0x7F, 0x00, 0x10};
+	uint8_t send_data[4] = {0xA5, 0x5A, 0x5A, 0xA5};
+	uint8_t recv_data[4] = {0};
+	uint8_t ovl_idx_t = 0;
+//	int retry2 = 0;
+
+//	uint8_t j = 0;
+	int allovlidx = 0;
+	uint8_t data[4] = {0};
+#if 0
+	if (ovl_idx == NULL) {
