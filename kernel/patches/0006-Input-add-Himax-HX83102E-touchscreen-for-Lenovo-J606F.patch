+	zf_info_arr[0].write_size = buf[7] << 24
+				| buf[6] << 16
+				| buf[5] << 8
+				| buf[4];
+	zf_info_arr[0].fw_addr = buf[11] << 24
+				| buf[10] << 16
+				| buf[9] << 8
+				| buf[8];
+
+#if 1
+	for (i = 1; i < part_num; i++) {
+		/*3. get all partition*/
+		memcpy(buf, &fw_entry->data[i * 0x10 + cfg_table_pos], 16);
+
+		memcpy(zf_info_arr[i].sram_addr, buf, 4);
