+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K4H7 8MP image sensor driver
+ *
+ * Register settings come from the CamX sensor module of the Lenovo Tab P11
+ * (TB-J606F) stock vendor image; the driver structure follows s5k3m5.c.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
