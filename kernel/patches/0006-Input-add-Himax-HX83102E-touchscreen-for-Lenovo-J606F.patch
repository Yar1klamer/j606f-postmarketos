+			hx83102_flash_write_burst(tmp_addr, tmp_data);
+			usleep_range(1000, 1001);
+			tmp_data[3] = 0x00;
+			tmp_data[2] = 0x00;
+			tmp_data[1] = 0x00;
+			tmp_data[0] = 0x01;
+			hx83102_flash_write_burst(tmp_addr, tmp_data);
