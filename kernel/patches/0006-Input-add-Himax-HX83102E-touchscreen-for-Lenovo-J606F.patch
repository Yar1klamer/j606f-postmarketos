+static int himax_dt_gpio(struct device *dev, const char *con_id)
+{
+	struct gpio_desc *desc = gpiod_get_optional(dev, con_id, GPIOD_ASIS);
+	int num;
+
+	if (IS_ERR(desc))
+		return PTR_ERR(desc);
+	if (!desc)
+		return -ENOENT;
+	num = desc_to_gpio(desc);
+	gpiod_put(desc);
+	return num;
+}
