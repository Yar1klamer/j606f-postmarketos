# Reference: <https://nura.eco/devicepkg>
# LOCAL package for Lenovo Tab P11 TB-J606F (HX83102P panel SKU).
# Temporary: ships out-of-tree modules and the DTB built for the binary
# linux-nura-qcom-sm61x5 7.2.3, until the kernel package carries the j606f patches.
pkgname=device-lenovo-j606f
pkgdesc="Lenovo Tab P11 (TB-J606F, HX83102P panel SKU)"
pkgver=1
pkgrel=2
url="https://nura.eco"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !tracedeps"
_kver="7.2.3-sm61x5"
depends="
	android-tools-mkbootimg
	kmod
	linux-nura-qcom-sm61x5=7.2.3-r0
	postmarketos-base
"
makedepends="devicepkg-dev"
install="$pkgname.post-install $pkgname.post-upgrade"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	modules-initfs
	j606f-depmod.conf
	j606f-modules-load.conf
	sm6115p-lenovo-j606f-hx83102p.dtb
	panel-himax-hx83102.ko
	tps65132-regulator.ko
	mm8013.ko
	ubwc_config.ko
	qcom_pd_mapper.ko
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/sm6115p-lenovo-j606f-hx83102p.dtb \
		"$pkgdir"/boot/dtbs/qcom/sm6115p-lenovo-j606f-hx83102p.dtb
	local m
	for m in panel-himax-hx83102 tps65132-regulator mm8013 ubwc_config qcom_pd_mapper; do
		install -Dm644 "$srcdir"/$m.ko "$pkgdir"/usr/lib/modules/$_kver/extra/$m.ko
	done
	install -Dm644 "$srcdir"/j606f-depmod.conf "$pkgdir"/usr/lib/depmod.d/j606f.conf
	install -Dm644 "$srcdir"/j606f-modules-load.conf "$pkgdir"/usr/lib/modules-load.d/j606f.conf
}

nonfree_firmware() {
	pkgdesc="GPU/WiFi/BT/DSP firmware"
	depends="firmware-lenovo-j606f linux-firmware-ath10k linux-firmware-qcom
		rmtfs tqftpserv qbootctl"
	mkdir "$subpkgdir"
}

