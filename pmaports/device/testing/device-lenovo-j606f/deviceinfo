deviceinfo_format_version="0"
deviceinfo_manufacturer="Lenovo"
deviceinfo_name="Tab P11"
deviceinfo_codename="lenovo-j606f"
deviceinfo_year="2020"
deviceinfo_dtb="qcom/sm6115p-lenovo-j606f-hx83102p"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"
deviceinfo_screen_width="1200"
deviceinfo_screen_height="2000"
