#!/bin/busybox sh
# Отладочный initramfs для первой загрузки mainline на TB-J606F.
# Поднимает USB-гаджет ECM (сеть) + ACM (последовательная консоль), DHCP, telnetd, httpd.
# Rootfs не монтирует, во внутреннюю память ничего не пишет.
/bin/busybox mkdir -p /bin /sbin /usr/bin /usr/sbin
/bin/busybox --install -s
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mkdir -p /proc /sys /dev /tmp /run /www/cgi-bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mkdir -p /sys/fs/pstore && mount -t pstore pstore /sys/fs/pstore 2>/dev/null

log() { echo "j606f-debug: $*" > /dev/kmsg; echo "j606f-debug: $*" > /dev/tty0 2>/dev/null; }
log "initramfs up, kernel $(uname -r)"

# Логи предыдущей загрузки (ramoops), если сохранились
mkdir -p /tmp/pstore-prev && cp -a /sys/fs/pstore/. /tmp/pstore-prev/ 2>/dev/null

for m in libcomposite u_ether usb_f_ecm u_serial usb_f_acm; do
	insmod /lib/modules/$m.ko || log "insmod $m FAILED"
done

i=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 100 ]; do sleep 0.2; i=$((i + 1)); done
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
log "UDC=${UDC:-none}"

G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G $G/strings/0x409 $G/configs/c.1/strings/0x409
echo 0x18d1 > $G/idVendor
echo 0xd001 > $G/idProduct
echo "Lenovo" > $G/strings/0x409/manufacturer
echo "TB-J606F mainline debug" > $G/strings/0x409/product
echo "j606f-debug" > $G/strings/0x409/serialnumber
mkdir -p $G/functions/ecm.usb0 $G/functions/acm.usb0
echo "<MAC>" > $G/functions/ecm.usb0/dev_addr
echo "<MAC>" > $G/functions/ecm.usb0/host_addr
echo "ecm+acm" > $G/configs/c.1/strings/0x409/configuration
echo 500 > $G/configs/c.1/MaxPower
ln -s $G/functions/ecm.usb0 $G/configs/c.1/
ln -s $G/functions/acm.usb0 $G/configs/c.1/
[ -n "$UDC" ] && echo "$UDC" > $G/UDC

i=0
while ! ip link show usb0 >/dev/null 2>&1 && [ $i -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
ip addr add 172.16.42.1/24 dev usb0
ip addr add 169.254.42.1/16 dev usb0
ip link set usb0 up

cat > /tmp/udhcpd.conf <<CONF
start 172.16.42.2
end 172.16.42.2
interface usb0
max_leases 1
lease_file /tmp/udhcpd.leases
option subnet 255.255.255.0
option lease 3600
CONF
touch /tmp/udhcpd.leases
udhcpd /tmp/udhcpd.conf
telnetd -b 172.16.42.1:23 -l /bin/sh
httpd -p 172.16.42.1:80 -h /www

# Последовательная консоль на ACM (на Mac: /dev/cu.usbmodem*)
( while true; do setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &

log "ready: telnet/http 172.16.42.1, ACM shell on ttyGS0"

# Командный сервер для scripts/tcp_run.sh (в busybox-static нет telnetd/httpd)
( nc -lk -p 9100 -e /bin/sh & )

# Дополнительные модули (порядок с учётом зависимостей задан при сборке образа)
if [ -s /etc/modules.load ]; then
	( for m in $(cat /etc/modules.load); do
		echo "insmod $m" > /dev/kmsg
		insmod /lib/modules/$m.ko >> /tmp/modload.log 2>&1 || echo "FAIL $m" >> /tmp/modload.log
	done; echo DONE >> /tmp/modload.log ) &
fi

# Страховка: без пользователя планшет нельзя перезагрузить кнопкой. Если за 300 с хост ни разу
# не обратился к http://172.16.42.1/cgi-bin/* (CGI создаёт /tmp/keepalive), перезагрузиться в Android.
( sleep 300; if [ ! -e /tmp/keepalive ] && [ ! -e /tmp/nc-contact ]; then log "no host contact in 300s, reboot"; sync; reboot -f; fi ) &
dmesg > /tmp/dmesg.boot

while true; do sleep 3600; done
