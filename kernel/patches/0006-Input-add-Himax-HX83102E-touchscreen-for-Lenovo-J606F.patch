+
+	/*1. get number of partition*/
+	part_num = fw_entry->data[cfg_table_pos + 12];
+
+	D("%s, Number of partition is %d\n", __func__, part_num);
+	if (part_num < 1) {
+		E("%s, size of cfg part failed! part_num = %d\n",
+			__func__, part_num);
