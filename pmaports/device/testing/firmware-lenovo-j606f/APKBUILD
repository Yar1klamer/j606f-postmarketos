# DRAFT, local use only: the firmware blobs come from this unit's own stock partitions
# (BACKUP/firmware/*.tar, squashed with scripts/pil_squash.py). Do not publish the tarball.
pkgname=firmware-lenovo-j606f
pkgver=1
pkgrel=0
pkgdesc="Firmware for Lenovo Tab P11 (TB-J606F)"
url="https://nura.eco"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
source="firmware-lenovo-j606f-$pkgver.tar"

package() {
	cd "$srcdir"
	# qcom/sm6115/LENOVO/J606F/{a610_zap,adsp,cdsp,modem,wlanmdsp}.mbn, qca/crbtfw21.tlv, qca/crnv21.bin
	find qcom qca -type f | while read -r f; do
		install -Dm644 "$f" "$pkgdir/lib/firmware/$f"
	done
}

sha512sums="
236c5b03074b6c2b47b171d350fecd89571744e881e573326f24b6bd7b5575b3d4f455f3d54b4eb18991d7fbc227e86a57f285f78e71e78b0b84a41c9243d353  firmware-lenovo-j606f-1.tar
"
