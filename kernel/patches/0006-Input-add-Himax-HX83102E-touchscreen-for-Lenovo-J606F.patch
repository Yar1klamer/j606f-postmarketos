+    if (ts->charger_detection) {
+        if (ts->charger_detection->charger_notif.notifier_call)
+            power_supply_unreg_notifier(&ts->charger_detection->charger_notif);
+            destroy_workqueue(ts->charger_detection->himax_charger_notify_wq);
+            ts->charger_detection->himax_charger_notify_wq = NULL;
+            kfree(ts->charger_detection);
+    }
+err_charger_detection_alloc_failed:
+err_charger_notify_wq_failed:
+#endif
+
+#if defined(HX_BOOT_UPGRADE) || defined(HX_ZERO_FLASH)
+	cancel_delayed_work_sync(&ts->work_boot_upgrade);
+	destroy_workqueue(ts->himax_boot_upgrade_wq);
+err_boot_upgrade_wq_failed:
+#endif
+
+error_ic_detect_failed:
+	himax_gpio_power_deconfig(pdata);
+#if !defined(CONFIG_OF)
+err_power_failed:
+#endif
+err_alloc_dt_pdata_failed:
+	kfree(hx_touch_data);
+	hx_touch_data = NULL;
+err_alloc_touch_data_failed:
+	kfree(ic_data);
+	ic_data = NULL;
+err_dt_ic_data_fail:
+	kfree(pdata);
+	pdata = NULL;
+err_dt_platform_data_fail:
+	devm_kfree(ts->dev, ts->xfer_buff);
+	ts->xfer_buff = NULL;
+err_xfer_buff_fail:
+	probe_fail_flag = 1;
+	return err;
+}
