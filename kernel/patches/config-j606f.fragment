# Добавить к config-nura-qcom-sm61x5.aarch64 для TB-J606F (HX83102P SKU)
CONFIG_DRM_PANEL_HIMAX_HX83102=m
CONFIG_REGULATOR_TPS65132=m
CONFIG_FUEL_GAUGE_MM8013=m
# второй SKU (NT36523W) — на будущее
CONFIG_DRM_PANEL_NOVATEK_NT36523=m
CONFIG_CHARGER_QCOM_PMI632=m
CONFIG_TOUCHSCREEN_HIMAX_HX83102E=m
CONFIG_TYPEC_FUSB302=m
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# звук (r116): динамики AW88258 на PRIMARY TDM, гарнитура USB-C через WCD937x (LPASS RX/TX/VA macro, SoundWire, q6 APR, машинный драйвер sm8250/RB2)
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_SM8250=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_WCD937X_SDW=m
CONFIG_SND_SOC_AW88258=m
